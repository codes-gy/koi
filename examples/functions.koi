// 식 본문 함수와 재귀
fun 팩토리얼(n: Int): Int = if (n <= 1) 1 else n * 팩토리얼(n - 1)

// 기본값 인자와 이름 붙은 인자
fun 인사(이름: String, 인사말: String = "안녕", 반복: Int = 1): String {
    var 결과 = ""
    repeat(반복) { 결과 += "$인사말, $이름! " }
    return 결과
}

// 함수를 받는 함수
fun 적용(횟수: Int, 변환: (Int) -> Int, 시작: Int): Int {
    var 값 = 시작
    repeat(횟수) { 값 = 변환(값) }
    return 값
}

// 클로저: 만들어질 때의 변수를 기억하고 바꿀 수 있습니다
fun 카운터(): () -> Int {
    var 횟수 = 0
    return { 횟수 += 1; 횟수 }
}

// 파일에 main이 있으면 마지막에 자동으로 실행됩니다
fun main() {
    println("10! = ${팩토리얼(10)}")
    println(인사("Koi"))
    println(인사(반복 = 2, 이름 = "철수", 인사말 = "반가워"))

    println("2를 세 번 제곱하면 ${적용(3, { it * it }, 2)}")

    val 다음번호 = 카운터()
    다음번호()
    다음번호()
    println("번호표: ${다음번호()}번")
}
